{
  "name": "reverse-dictionary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "eval": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --tag baseline",
    "eval:exact": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --exact --tag exact",
    "eval:filtered": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --filter-junk --tag filtered",
    "eval:compare": "tsx scripts/eval.ts --compare",
    "eval:report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@xenova/transformers": "^2.17.2",
    "next": "14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.23",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wordnet-db": "^3.1.14"
  }
}
