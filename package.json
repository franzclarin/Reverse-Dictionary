{
  "name": "reverse-dictionary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "fetch-model": "node scripts/fetch-model.mjs",
    "build-viz": "tsx scripts/build-viz-snapshot.ts && tsx scripts/build-tokenizer-asset.ts",
    "verify-viz": "tsx scripts/verify-viz-snapshot.ts",
    "build": "npm run fetch-model && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "eval": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --tag baseline",
    "eval:prod": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --index GlossEmbedding --tag prod_wikt_shipped",
    "eval:exact": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --exact --tag exact",
    "eval:filtered": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --filter-junk --tag filtered",
    "eval:rerank": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --index GlossEmbedding --rerank --rerank-depth 100 --rerank-sweep 10,25,50 --tag rerank_ce6",
    "eval:control": "tsx scripts/eval.ts --set eval/sets/v1.jsonl --index-file full_gloss_ft --tag rd17_control",
    "supplement:fetch": "tsx scripts/fetch-wiktionary.ts",
    "supplement:build": "tsx scripts/build-supplement.ts",
    "supplement:cell": "tsx scripts/build-supplement-cell.ts --embed --compose",
    "supplement:verify": "tsx scripts/verify-supplement-cell.ts",
    "supplement:index": "tsx scripts/build-supplement-index.ts",
    "probe:reachability": "tsx scripts/probe-reachability.ts",
    "probe:oewn": "tsx scripts/probe-oewn-delta.ts",
    "probe:margin": "tsx scripts/probe-rank1-margin.ts",
    "eval:compare": "tsx scripts/eval.ts --compare",
    "eval:report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "@xenova/transformers": "^2.17.2",
    "next": "14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.23",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wordnet-db": "^3.1.14"
  }
}
