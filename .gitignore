# Model artifacts (large files, generated)
_model_tmp/
reverse_dict_model.zip
# RD-11: the ONNX model fetched at build time by scripts/fetch-model.mjs and
# traced into the function bundle. 86MB of regenerable artifact — never committed.
# Run `npm run fetch-model` once locally; the eval scripts need it too.
/models/
.env*

# Agent skill docs auto-installed by `vercel integration add` — regenerable
.agents/
.claude/skills/
skills-lock.json

# Evaluation
# Runs are regenerable, but the reference baselines are committed: every future
# change is judged against them.
eval/runs/*
!eval/runs/baseline.json
!eval/runs/exact.json
!eval/runs/filtered.json
# The production gloss path's reference run (RD-02 cutover). baseline.json now
# describes the ROLLBACK path, so without this there is no committed reference
# for what search actually does today.
!eval/runs/prod_gloss_shipped.json
# RD-17: the current production path. `prod_gloss_shipped` above is now the
# PRE-EXPANSION baseline — kept so "versus what we replaced" stays answerable —
# and `npm run eval:prod` writes this tag instead of overwriting it.
!eval/runs/prod_wikt_shipped.json
# RD-12: full candidate shortlists with gloss text, written beside each rerank
# run. Reproducibility detail only an audit or a re-scoring reads, and large —
# the compact form (synsetKey + cosine + cross-encoder score) is inside the run
# JSON itself, which is what stays committed.
eval/runs/*.shortlist.jsonl
# Working artifacts, not results
eval/data/pool-manifest.json
eval/audit/
# Timestamped backups written by apply-acceptable-recommendations.ts
eval/sets/*.bak-*

# RD-17: the vocabulary-expansion manifest IS committed (eval/data/supplement-manifest.json)
# — it is the filter's recorded output: row counts, per-rule kill counts, source
# sha256 and the licence. The 3.2 GB Kaikki extraction, the filtered JSONL rows and
# the composed cells are not: all three are regenerable from that manifest's URL plus
# `scripts/lib/wiktionary.ts`, and they live outside the repo anyway (RD_SOURCE_DIR,
# EVAL_CELL_DIR). Committing a cache is not the same as committing a record.
eval/runs/*.manifest.jsonl

# --- RD-22: the Python training surface (training/) -------------------------
# Dev-only and never deployed. The venv and every derived artifact stay out;
# the notebooks, rdlib/ and the lockfile are committed.
training/.venv/
training/**/__pycache__/
training/**/*.egg-info/
training/**/.ipynb_checkpoints/
.ipynb_checkpoints/

# Checkpoints, generated training pairs, ONNX exports, pre-registrations.
# Regenerate from the notebooks; a checkpoint is a cache, not a record.
training/artifacts/
