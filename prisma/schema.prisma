generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Word {
  id             String   @id @default(cuid())
  word           String   @unique
  partOfSpeech   String
  definition     String
  pronunciation  String
  etymology      String
  examples       String[]
  synonyms       String[]
  domain         String
  obscurityScore Int      @default(50)
  createdAt      DateTime @default(now())
}

model VocabEmbedding {
  id        Int                        @id @default(autoincrement())
  word      String                     @unique
  embedding Unsupported("vector(384)")
}

/// The production search index since the RD-02 cutover (2026-08-27): one row
/// per WordNet synset, keyed by synset rather than by word, holding the sense's
/// gloss text rather than its bare lemma. 117,791 rows, populated and queried
/// by /api/lookup via lib/glossSearch.ts. Indexing definitions instead of words
/// is what cut lexical echo from ~41% to 14.5% and lifted lenient Recall@1 from
/// 10.1% to 24.0%; VocabEmbedding stays populated as the rollback path.
///
/// halfvec, not vector: at fp32 this index would not fit alongside
/// VocabEmbedding under Neon's 512MB project ceiling. Measured as free —
/// 0 discordant pairs against the fp32 cell.
model GlossEmbedding {
  id        Int                         @id @default(autoincrement())
  /// "<pos>:<wordnet offset>", e.g. "noun:00123456".
  synsetKey String                      @unique
  pos       String
  /// WordNet definition text only (no examples) — the exact string embedded.
  gloss     String
  /// Synset members in WordNet's own within-synset order (sense familiarity)
  /// — the eval-validated production expansion order ("--expansion-order
  /// wordnet", +2.5pp lenient R@1 over zipf ordering). Stored, not
  /// recomputed at query time.
  lemmas    String[]
  embedding Unsupported("halfvec(384)")
}

/// Sampled agreement log between the two indexes, written by /api/lookup.
///
/// Built to gate the RD-02 cutover on real traffic; that gate was RETIRED
/// unreachable at n=2 rather than satisfied — this app has no traffic — and the
/// cutover was decided on the offline eval set instead. Kept on because the
/// question was never answered: if traffic ever arrives, the comparison becomes
/// worth running retroactively.
///
/// Roles inverted at the cutover: the gloss index is primary now, so the shadow
/// query runs against the old lemma index. The columns keep their original
/// meaning — old* is ALWAYS the lemma index, new* ALWAYS the gloss index — so
/// rows from before and after the cutover stay comparable.
///
/// Logs a query hash, never query text, preserving the "no query text has ever
/// been logged" property. Top-1 only: enough for an agreement rate, not enough
/// to reconstruct a query or a paired accuracy comparison (production traffic
/// carries no labelled target either way).
model ShadowLookup {
  id            String   @id @default(cuid())
  queryHash     String
  oldTop1       String
  oldSimilarity Float
  newTop1       String
  newSimilarity Float
  agree         Boolean
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
