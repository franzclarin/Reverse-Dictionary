generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Word {
  id             String   @id @default(cuid())
  word           String   @unique
  partOfSpeech   String
  definition     String
  pronunciation  String
  etymology      String
  examples       String[]
  synonyms       String[]
  domain         String
  obscurityScore Int      @default(50)
  createdAt      DateTime @default(now())
}

model VocabEmbedding {
  id        Int                        @id @default(autoincrement())
  word      String                     @unique
  embedding Unsupported("vector(384)")
}

/// The production search index since the RD-02 cutover (2026-08-27): one row
/// per WordNet synset, keyed by synset rather than by word, holding the sense's
/// gloss text rather than its bare lemma. 117,791 rows, populated and queried
/// by /api/lookup via lib/glossSearch.ts. Indexing definitions instead of words
/// is what cut lexical echo from ~41% to 14.5% and lifted lenient Recall@1 from
/// 10.1% to 24.0%; VocabEmbedding stays populated as the rollback path.
///
/// halfvec, not vector: at fp32 this index would not fit alongside
/// VocabEmbedding under Neon's 512MB project ceiling. Measured as free —
/// 0 discordant pairs against the fp32 cell.
model GlossEmbedding {
  id        Int                         @id @default(autoincrement())
  /// "<pos>:<wordnet offset>", e.g. "noun:00123456".
  synsetKey String                      @unique
  pos       String
  /// WordNet definition text only (no examples) — the exact string embedded.
  gloss     String
  /// Synset members in WordNet's own within-synset order (sense familiarity)
  /// — the eval-validated production expansion order ("--expansion-order
  /// wordnet", +2.5pp lenient R@1 over zipf ordering). Stored, not
  /// recomputed at query time.
  lemmas    String[]
  embedding Unsupported("halfvec(384)")

  /// GIN over `lemmas` (RD-17). Backs the word-page existence check, which asks
  /// whether the SEARCH index can answer with a word — `VocabEmbedding` is the
  /// rollback path and disagrees with this table on 8,005 lemmas. Without it
  /// that check is a sequential scan on every /word/<slug> render.
  @@index([lemmas], type: Gin)
}

/// Sampled agreement log between the two indexes, written by /api/lookup.
///
/// Built to gate the RD-02 cutover on real traffic; that gate was RETIRED
/// unreachable at n=2 rather than satisfied — this app has no traffic — and the
/// cutover was decided on the offline eval set instead. Kept on because the
/// question was never answered: if traffic ever arrives, the comparison becomes
/// worth running retroactively.
///
/// Roles inverted at the cutover: the gloss index is primary now, so the shadow
/// query runs against the old lemma index. The columns keep their original
/// meaning — old* is ALWAYS the lemma index, new* ALWAYS the gloss index — so
/// rows from before and after the cutover stay comparable.
///
/// Logs a query hash, never query text, preserving the "no query text has ever
/// been logged" property. Top-1 only: enough for an agreement rate, not enough
/// to reconstruct a query or a paired accuracy comparison (production traffic
/// carries no labelled target either way).
model ShadowLookup {
  id            String   @id @default(cuid())
  queryHash     String
  oldTop1       String
  oldSimilarity Float
  newTop1       String
  newSimilarity Float
  agree         Boolean
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

/// Every real search, as typed, with what came back. Written by /api/lookup
/// after the response has been computed but before it is returned.
///
/// RETIRES the "no query text has ever been logged" property that ShadowLookup
/// above was built to preserve (2026-08-31, RD-24). That property is why the
/// eval set is hand-authored blind (RD-10); rows here are the first
/// real-phrasing sample this project has ever had, and they are UNLABELLED —
/// they carry no correct answer, so they can measure phrasing and popularity,
/// never accuracy.
///
/// /explain's `debug: true` requests are deliberately excluded: those are
/// someone poking at the demo, and counting them would change what this means.
model QueryLog {
  id          String   @id @default(cuid())
  /// The description as typed, untrimmed and uncased. At most 500 characters,
  /// enforced by the route's existing validation.
  query       String
  /// How many results were asked for. "Load more" re-runs the same query with a
  /// larger k, so repeated rows with the same text are expected, not duplicates.
  k           Int
  /// [{ word, similarity }, …] in rank order — the exact array returned to the
  /// client, jsonb so the order survives and the two halves cannot desync.
  results     Json
  resultCount Int
  /// Embed + pgvector time only, matching the `timingMs` the client is shown.
  timingMs    Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
